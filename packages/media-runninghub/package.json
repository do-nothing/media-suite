{
  "name": "@tmmk/media-runninghub",
  "version": "0.1.2",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "description": "RunningHub 媒体工具：Nano Banana 2 图片生成与工作流任务池。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "runninghub",
    "image-generation",
    "video-generation",
    "workflow"
  ],
  "homepage": "https://github.com/do-nothing/media-suite/tree/main/packages/media-runninghub",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/do-nothing/media-suite.git",
    "directory": "packages/media-runninghub"
  },
  "license": "Apache-2.0",
  "scripts": {
    "test": "node tests/run-all.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./config/task-types.json": "./config/task-types.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "client.js",
    "cordis.patch.yml",
    "config/task-types.json",
    "skill/runninghub-workflow/SKILL.md",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
