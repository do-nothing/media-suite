{
  "name": "@tmmk/media-suite",
  "version": "0.1.4",
  "type": "module",
  "main": "index.js",
  "engines": { "node": "^22.19.0 || >=24.0.0", "dsh": ">=0.2.1-rc.3" },
  "packageManager": "pnpm@11.7.0",
  "description": "媒体插件家族：一次安装 Qwen 与 RunningHub 媒体能力，并提供跨 provider 的全局设置。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/do-nothing/media-suite.git",
    "directory": "packages/media-suite"
  },
  "homepage": "https://github.com/do-nothing/media-suite/tree/main/packages/media-suite",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "media",
    "bundle"
  ],
  "license": "Apache-2.0",
  "publishConfig": { "registry": "https://registry.npmjs.org/", "access": "public" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@tmmk/media-qwen": "^0.1.2",
    "@tmmk/media-runninghub": "^0.1.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
