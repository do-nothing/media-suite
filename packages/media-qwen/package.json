{
  "name": "@tmmk/media-qwen",
  "version": "0.1.2",
  "type": "module",
  "main": "index.js",
  "engines": { "node": "^22.19.0 || >=24.0.0", "dsh": ">=0.2.1-rc.3" },
  "packageManager": "pnpm@11.7.0",
  "description": "Qwen 媒体工具：多模态理解、语音合成与场景音频生成。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "qwen",
    "dashscope",
    "multimodal",
    "tts"
  ],
  "homepage": "https://github.com/do-nothing/media-suite/tree/main/packages/media-qwen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/do-nothing/media-suite.git",
    "directory": "packages/media-qwen"
  },
  "license": "Apache-2.0",
  "publishConfig": { "registry": "https://registry.npmjs.org/", "access": "public" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
